<Application
    x:Class="DotOrbit.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Assets/OrbitMark.axaml" />
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="RadioButton.nav-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              x:Name="NavItemBorder"
              Padding="{TemplateBinding Padding}"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="9">
            <Grid>
              <Border
                  x:Name="SelectionIndicator"
                  Width="3"
                  Height="18"
                  Margin="-5,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{StaticResource AccentBrush}"
                  CornerRadius="2"
                  IsVisible="{TemplateBinding IsChecked}" />
              <ContentPresenter
                  x:Name="NavigationContent"
                  Margin="{StaticResource NavigationContentInset}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="Center"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav-item:pointerover">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="RadioButton.nav-item:checked">
      <Setter Property="Background" Value="{StaticResource AccentSurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="RadioButton.nav-item:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="TextBlock.nav-count">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource QuietTextBrush}" />
      <Setter Property="MinWidth" Value="22" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.view-action">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.view-action:pointerover">
      <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.view-action:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    </Style>
    <Style Selector="Button.primary-action">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{StaticResource AccentContentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="13,8" />
    </Style>
    <Style Selector="Button.primary-action:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primary-action:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    </Style>
    <Style Selector="Button.project-title, Button.task-title">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style Selector="Button.row-title:pointerover, Button.row-title:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.row-title:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     Button.row-title:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.project-title:focus-visible, Button.task-title:focus-visible">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    </Style>
    <Style Selector="TextBox.inspector-title">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{StaticResource TypeSizeTitle}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="5,5" />
    </Style>
    <Style Selector="TextBox.inspector-title:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource ControlHoverBorderBrush}" />
    </Style>
    <Style Selector="TextBox.inspector-title:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox.inspector-field, ComboBox.inspector-field">
      <Setter Property="Background" Value="{StaticResource PanelInputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9" />
    </Style>
    <Style Selector="TextBlock.inspector-label">
      <Setter Property="Foreground" Value="{StaticResource QuietTextBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1.25" />
    </Style>
    <StyleInclude Source="/Styles/ComponentRecipes.axaml" />
  </Application.Styles>
</Application>

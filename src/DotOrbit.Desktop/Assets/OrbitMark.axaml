<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="OrbitMarkImage">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing
            Brush="Transparent"
            Geometry="M 0,0 H 32 V 32 H 0 Z" />
        <GeometryDrawing Geometry="M 16,8 A 8,8 0 1 1 15.99,8">
          <GeometryDrawing.Pen>
            <Pen Brush="{DynamicResource AccentBrush}" Thickness="3" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing
            Brush="{DynamicResource SuccessBrush}"
            Geometry="M 22,7 A 3,3 0 1 1 21.99,7" />
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>
</ResourceDictionary>

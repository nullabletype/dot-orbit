      <SolidColorBrush x:Key="CategoryLimeBrush">#607D1E</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryTangerineBrush">#A75A13</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryRoseBrush">#A33D64</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryCobaltBrush">#315CB5</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryCyanBrush">#087B96</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryEmeraldBrush">#247A43</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryGoldBrush">#76651A</SolidColorBrush>

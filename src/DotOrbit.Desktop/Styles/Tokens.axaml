      <SolidColorBrush x:Key="CategoryVioletBrush">#AFA4FF</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryIndigoBrush">#7F9CFF</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryOceanBrush">#56B4E9</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryTealBrush">#53C7B7</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryLimeBrush">#B6D96A</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryTangerineBrush">#F2A65A</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryRoseBrush">#EF7FA6</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryCobaltBrush">#6F8EF6</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryCyanBrush">#48C8E8</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryEmeraldBrush">#62CD86</SolidColorBrush>
      <SolidColorBrush x:Key="CategoryGoldBrush">#D8C260</SolidColorBrush>

<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.list-panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="Padding" Value="{StaticResource PanelInset}" />
  </Style>
  <Style Selector="Border.attention-panel">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
  </Style>
  <Style Selector="Ellipse.category-colour-marker.orchid"><Setter Property="Fill" Value="{DynamicResource CategoryOrchidBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.violet"><Setter Property="Fill" Value="{DynamicResource CategoryVioletBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.indigo"><Setter Property="Fill" Value="{DynamicResource CategoryIndigoBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.ocean"><Setter Property="Fill" Value="{DynamicResource CategoryOceanBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.teal"><Setter Property="Fill" Value="{DynamicResource CategoryTealBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.lime"><Setter Property="Fill" Value="{DynamicResource CategoryLimeBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.tangerine"><Setter Property="Fill" Value="{DynamicResource CategoryTangerineBrush}" /></Style>
  <Style Selector="Ellipse.category-colour-marker.rose"><Setter Property="Fill" Value="{DynamicResource CategoryRoseBrush}" /></Style>
  <Style Selector="Border.category-pill">
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.category-pill TextBlock.category-identity-name">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="UserControl.category-heading-identity TextBlock.category-identity-name">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="UserControl.category-metadata-identity TextBlock.category-identity-name">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" />
  </Style>
  <Style Selector="Border.empty-state">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    <Setter Property="Padding" Value="44" />
  </Style>
  <Style Selector="Button.task-row-action">
    <Setter Property="MinHeight" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector=":is(ContentControl).markdown-preview">
    <Setter Property="MinHeight" Value="122" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource PanelInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector=":is(ContentControl).markdown-preview:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
  </Style>
  <Style Selector=":is(ContentControl).markdown-preview:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
  </Style>

  <Style Selector="Button.drag-handle">
    <Setter Property="MinWidth" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Height" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <Grid Width="8" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
              ColumnDefinitions="*,*" RowDefinitions="*,*,*">
            <Ellipse Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Row="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Row="2" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
            <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.drag-handle:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.drag-handle:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
  </Style>

  <Style Selector="ToggleButton.completion-toggle">
    <Setter Property="Width" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Height" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
    <Setter Property="Foreground" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <Border x:Name="CompletionBox" Width="{StaticResource ControlGlyphSize}" Height="{StaticResource ControlGlyphSize}"
              HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{TemplateBinding CornerRadius}">
            <Path x:Name="CompletionTick" Width="12" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 2,6 L 5,9 L 11,2" IsVisible="{TemplateBinding IsChecked}" Stroke="{TemplateBinding Foreground}"
                StrokeLineCap="Round" StrokeJoin="Round" StrokeThickness="1.8" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.completion-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.completion-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.completion-toggle:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.completion-toggle:focus /template/ Border#CompletionBox,
                   ToggleButton.completion-toggle:focus-visible /template/ Border#CompletionBox">
    <Setter Property="BoxShadow" Value="{DynamicResource InteractionFocusShadow}" />
  </Style>
  <Style Selector="ToggleButton.completion-toggle:checked:focus /template/ Border#CompletionBox,
                   ToggleButton.completion-toggle:checked:focus-visible /template/ Border#CompletionBox,
                   ToggleButton.completion-toggle:checked:pointerover:focus /template/ Border#CompletionBox,
                   ToggleButton.completion-toggle:checked:pointerover:focus-visible /template/ Border#CompletionBox">
    <Setter Property="BoxShadow" Value="{DynamicResource CheckedFocusShadow}" />
  </Style>

  <Style Selector="ToggleButton.today-toggle">
    <Setter Property="Width" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Height" Value="{StaticResource ControlHitSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            x:Name="TodayFocusBorder"
            Width="{TemplateBinding Width}"
            Height="{TemplateBinding Height}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}">
          <Grid>
            <Path
                x:Name="TodayStarOutline"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M12,17.27 18.18,21 16.54,13.97 22,9.24 14.81,8.62 12,2 9.19,8.62 2,9.24 7.45,13.97 5.82,21Z"
                Fill="Transparent"
                Stroke="{TemplateBinding Foreground}"
                StrokeThickness="1.6"
                Stretch="Uniform" />
            <Path
                x:Name="TodayStarFill"
                Width="18"
                Height="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M12,17.27 18.18,21 16.54,13.97 22,9.24 14.81,8.62 12,2 9.19,8.62 2,9.24 7.45,13.97 5.82,21Z"
                Fill="{TemplateBinding Foreground}"
                IsVisible="False"
                Stretch="Uniform" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.today-toggle:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.today-toggle:checked">
    <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
  </Style>
  <Style Selector="ToggleButton.today-toggle:checked /template/ Path#TodayStarOutline">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.today-toggle:checked /template/ Path#TodayStarFill">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.today-toggle:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
  </Style>

  <Style Selector="Border.interactive-row"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Border.interactive-row:pointerover"><Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" /></Style>
  <Style Selector="Border.separated-row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineSoftBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.separated-row.last"><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="TextBlock.task-date">
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.task-completion-date">
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.project-row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
  </Style>
  <Style Selector="Border.category-row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
  </Style>
  <Style Selector="Border.expandable-header-row"><Setter Property="CornerRadius" Value="9" /></Style>
  <Style Selector="Border.expandable-header-row.expanded"><Setter Property="CornerRadius" Value="9,9,0,0" /></Style>
  <Style Selector="Border.reorder-target.drag-target">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.decision-overlay">
    <Setter Property="Padding" Value="24" />
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="{DynamicResource OverlayShadow}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="ToggleButton.disclosure">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource QuietTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path x:Name="DisclosureExpanded" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 1,3 L 6,8 L 11,3" IsVisible="False" Stroke="{TemplateBinding Foreground}"
                StrokeLineCap="Round" StrokeJoin="Round" StrokeThickness="1.6" />
            <Path x:Name="DisclosureCollapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 3,1 L 8,6 L 3,11" Stroke="{TemplateBinding Foreground}"
                StrokeLineCap="Round" StrokeJoin="Round" StrokeThickness="1.6" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.disclosure:checked /template/ Path#DisclosureExpanded">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleButton.disclosure:checked /template/ Path#DisclosureCollapsed">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleButton.disclosure:pointerover,
                   ToggleButton.disclosure:checked,
                   ToggleButton.disclosure:checked:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.disclosure:focus, ToggleButton.disclosure:focus-visible,
                   ToggleButton.disclosure:checked:focus, ToggleButton.disclosure:checked:focus-visible,
                   ToggleButton.disclosure:checked:pointerover:focus, ToggleButton.disclosure:checked:pointerover:focus-visible">
    <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <Style Selector="TextBlock.status-marker.not-started"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Style>
  <Style Selector="TextBlock.status-marker.in-progress"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}" /></Style>
  <Style Selector="TextBlock.status-marker.complete"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Ellipse.status-marker.not-started"><Setter Property="Fill" Value="{DynamicResource QuietTextBrush}" /></Style>
  <Style Selector="Ellipse.status-marker.in-progress"><Setter Property="Fill" Value="{DynamicResource AmberBrush}" /></Style>
  <Style Selector="Ellipse.status-marker.complete"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.status-badge">
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
  </Style>
  <Style Selector="Border.status-badge TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.transient-status">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource CompactControlRadius}" />
  </Style>
  <Style Selector="TextBlock.transient-status-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.validation-message">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
  </Style>
  <Style Selector="HyperlinkButton.markdown-link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="HyperlinkButton.markdown-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="HyperlinkButton.markdown-link:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource FocusBorder}" />
  </Style>
  <Style Selector="TextBox.inspector-title.error, TextBox.inspector-field.error, ComboBox.inspector-field.error, :is(CalendarDatePicker).inspector-field.error">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector=":is(CalendarDatePicker).inspector-field">
    <Setter Property="Width" Value="150" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource PanelInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource ControlBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" />
  </Style>
  <Style Selector="Calendar"><Setter Property="FontSize" Value="{StaticResource TypeSizeEyebrow}" /></Style>
</Styles>

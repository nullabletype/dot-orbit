<UserControl
    x:Class="DotOrbit.Desktop.Views.CategoryProjectPill"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DotOrbit.Desktop.Views"
    Focusable="False"
    IsHitTestVisible="False"
    MaxWidth="360"
    AutomationProperties.AccessibilityView="Raw">
  <Border Classes="category-project-pill">
    <Grid ColumnDefinitions="Auto,Auto,Auto">
      <StackPanel Margin="7,0,6,0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <views:IdentityTypeIcon WorkType="Category" ColourKey="{Binding CategoryColourKey, ElementName=Root}" />
        <TextBlock Classes="identity-pill-name" MaxWidth="130" VerticalAlignment="Center"
            Text="{Binding CategoryName, ElementName=Root}" TextTrimming="CharacterEllipsis" />
        <Path Classes="category-pill-override-icon" Width="11" Height="11" IsVisible="{Binding HasOverride, ElementName=Root}"
            Data="{StaticResource CategoryOverrideIconData}" Fill="Transparent"
            Stroke="{DynamicResource QuietTextBrush}" StrokeLineCap="Round" StrokeJoin="Round"
            StrokeThickness="1.4" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
      </StackPanel>
      <Path x:Name="Join" Grid.Column="1" Width="8" Height="16" VerticalAlignment="Stretch"
          Data="M0,0 L8,8 L0,16" Fill="Transparent" Stroke="{DynamicResource LineBrush}"
          StrokeLineCap="Square" StrokeJoin="Miter" StrokeThickness="1"
          Stretch="Fill" AutomationProperties.AccessibilityView="Raw" />
      <StackPanel x:Name="ProjectSegment" Grid.Column="2" Margin="6,0,7,0"
          Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <views:IdentityTypeIcon WorkType="Project" ColourKey="{Binding ProjectColourKey, ElementName=Root}" />
        <TextBlock Classes="identity-pill-name" MaxWidth="130" VerticalAlignment="Center"
            Text="{Binding ProjectName, ElementName=Root}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

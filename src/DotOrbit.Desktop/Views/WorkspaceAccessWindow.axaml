<Window
    x:Class="DotOrbit.Desktop.Views.WorkspaceAccessWindow"
    x:DataType="vm:WorkspaceAccessViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotOrbit.Desktop.ViewModels"
    Title="dot-orbit workspace"
    Width="560"
    Height="660"
    MinWidth="500"
    MinHeight="600"
    Background="{DynamicResource BackgroundBrush}"
    WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="64,*">
    <Border
        Grid.Row="0"
        BorderBrush="{DynamicResource LineBrush}"
        BorderThickness="0,0,0,1">
      <StackPanel
          Margin="24,0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="10">
        <Image
            Width="30"
            Height="30"
            Source="{StaticResource OrbitMarkImage}"
            Stretch="Uniform" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="18"
            FontWeight="Bold"
            Text="dot-orbit" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel
          Width="440"
          Margin="40,38"
          HorizontalAlignment="Center"
          Spacing="14">
        <TextBlock
            Classes="eyebrow"
            Text="ENCRYPTED LOCAL WORKSPACE" />
        <TextBlock
            FontSize="28"
            FontWeight="Bold"
            Text="{Binding Heading}" />
        <TextBlock
            Margin="0,0,0,8"
            Foreground="{DynamicResource MutedTextBrush}"
            LineHeight="21"
            Text="{Binding Intro}"
            TextWrapping="Wrap" />

        <Border
            Classes="list-panel">
          <StackPanel Spacing="6">
            <TextBlock
                x:Name="WorkspaceFileLabel"
                Classes="eyebrow"
                Text="WORKSPACE FILE" />
            <TextBlock
                x:Name="SelectedWorkspacePath"
                AutomationProperties.HelpText="{Binding WorkspaceLocationStatus}"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="{Binding SelectedWorkspaceAccessibleName}"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="{Binding SelectedWorkspacePath}"
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <Button
              x:Name="ChooseExistingWorkspaceButton"
              Grid.Column="0"
              AutomationProperties.Name="Choose existing workspace"
              Click="ChooseExistingWorkspaceClick"
              HorizontalAlignment="Left"
              HorizontalContentAlignment="Center"
              TabIndex="0">
            <TextBlock Text="Choose existing" />
          </Button>
          <Button
              x:Name="ChooseNewWorkspaceButton"
              Grid.Column="1"
              AutomationProperties.Name="Choose where to create a new workspace"
              Click="ChooseNewWorkspaceClick"
              HorizontalAlignment="Right"
              HorizontalContentAlignment="Center"
              TabIndex="1">
            <TextBlock Text="Set up new workspace…" />
          </Button>
        </Grid>

        <TextBlock
            x:Name="WorkspaceResolutionMessage"
            AutomationProperties.LiveSetting="Assertive"
            AutomationProperties.Name="{Binding WorkspaceResolutionAnnouncementName}"
            Foreground="{DynamicResource ErrorBrush}"
            IsVisible="{Binding IsBlocked}"
            Text="{Binding BlockingMessage}"
            TextWrapping="Wrap" />

        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="10"
            IsVisible="{Binding IsWorkspaceUnavailable}">
          <Button
              x:Name="RetryWorkspaceButton"
              Grid.Column="0"
              AutomationProperties.Name="Retry selected workspace"
              Click="RetryWorkspaceClick"
              HorizontalContentAlignment="Center"
              IsVisible="{Binding CanRetryWorkspace}"
              TabIndex="2">
            <TextBlock Text="Retry" />
          </Button>
          <Button
              x:Name="UseDefaultWorkspaceButton"
              Grid.Column="1"
              AutomationProperties.Name="Return to default workspace location"
              Click="UseDefaultWorkspaceClick"
              HorizontalContentAlignment="Center"
              IsVisible="{Binding CanReturnToDefault}"
              TabIndex="3">
            <TextBlock Text="Use default location" />
          </Button>
        </Grid>

        <TextBlock
            IsVisible="{Binding IsCreateMode}"
            Text="First Category" />
        <TextBox
            x:Name="FirstCategoryTextBox"
            AutomationProperties.HelpText="Name the first Category before Projects or Tasks can be created."
            AutomationProperties.Name="First Category name"
            IsVisible="{Binding IsCreateMode}"
            TabIndex="4"
            Text="{Binding FirstCategoryName, Mode=TwoWay}"
            PlaceholderText="For example, Personal Admin" />

        <TextBlock
            Margin="0,6,0,0"
            IsVisible="{Binding IsWorkspaceAccessAvailable}"
            Text="Passphrase" />
        <TextBox
            x:Name="PassphraseTextBox"
            AutomationProperties.HelpText="Paste or type a passphrase. Password-manager generated values are supported."
            AutomationProperties.Name="Passphrase"
            IsVisible="{Binding IsWorkspaceAccessAvailable}"
            PasswordChar="{Binding PasswordCharacter}"
            TabIndex="5"
            Text="{Binding Passphrase, Mode=TwoWay}" />

        <TextBlock
            IsVisible="{Binding IsCreateMode}"
            Text="Confirm passphrase" />
        <TextBox
            x:Name="ConfirmationTextBox"
            AutomationProperties.HelpText="Enter the same passphrase again."
            AutomationProperties.Name="Confirm passphrase"
            IsVisible="{Binding IsCreateMode}"
            PasswordChar="{Binding PasswordCharacter}"
            TabIndex="6"
            Text="{Binding Confirmation, Mode=TwoWay}" />

        <ToggleButton
            x:Name="PassphraseVisibilityToggle"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="Change whether the passphrase fields display their text."
            AutomationProperties.Name="{Binding PassphraseVisibilityActionName}"
            Command="{Binding TogglePassphraseVisibilityCommand}"
            IsVisible="{Binding IsWorkspaceAccessAvailable}"
            IsChecked="{Binding IsPassphraseVisible, Mode=OneWay}"
            TabIndex="7">
          <TextBlock Text="{Binding PassphraseVisibilityActionName}" />
        </ToggleButton>

        <Border
            IsVisible="{Binding IsCreateMode}"
            Margin="0,4,0,0"
            Padding="14"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
          <StackPanel Spacing="6">
            <TextBlock
                x:Name="PassphraseGuidance"
                FontWeight="SemiBold"
                Text="Use 16 or more characters, or a multi-word passphrase."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="NoRecoveryWarning"
                Foreground="{DynamicResource MutedTextBrush}"
                Text="There is no recovery mechanism. If you lose this passphrase, the workspace cannot be opened."
                TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock
            x:Name="ValidationMessage"
            AutomationProperties.LiveSetting="Assertive"
            Foreground="{DynamicResource ErrorBrush}"
            IsVisible="{Binding HasValidationMessage}"
            Text="{Binding ValidationMessage}"
            TextWrapping="Wrap" />

        <Button
            x:Name="RestoreMigrationRecoveryButton"
            Margin="0,8,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="Restore pre-upgrade workspace"
            Command="{Binding RestoreMigrationRecoveryCommand}"
            IsVisible="{Binding CanRestoreMigrationRecovery}"
            TabIndex="8">
          <TextBlock Text="Restore pre-upgrade workspace" />
        </Button>

        <Button
            x:Name="SubmitButton"
            Margin="0,8,0,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{Binding SubmitActionName}"
            Command="{Binding SubmitCommand}"
            IsVisible="{Binding IsWorkspaceAccessAvailable}"
            IsDefault="True"
            TabIndex="9">
          <TextBlock Text="{Binding SubmitActionName}" />
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>

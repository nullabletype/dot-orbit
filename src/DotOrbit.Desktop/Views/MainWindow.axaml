<Window
    x:Class="DotOrbit.Desktop.Views.MainWindow"
    x:DataType="vm:ShellViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotOrbit.Desktop.ViewModels"
    xmlns:views="using:DotOrbit.Desktop.Views"
    Title="dot-orbit"
    Width="1180"
    Height="760"
    MinWidth="1120"
    MinHeight="600"
    Background="{StaticResource BackgroundBrush}">
  <Window.Resources>
    <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
      <RadioButton
          AutomationProperties.AutomationId="{Binding AutomationId}"
          AutomationProperties.HelpText="{Binding AccessibleHelpText}"
          AutomationProperties.ItemStatus="{Binding AccessibleCount}"
          AutomationProperties.Name="{Binding AccessibleName}"
          Classes="nav-item"
          Command="{Binding SelectCommand}"
          Focusable="True"
          GroupName="PrimaryNavigation"
          IsChecked="{Binding IsSelected, Mode=OneWay}">
        <Grid ColumnDefinitions="22,*,Auto">
          <PathIcon
              Width="15"
              Height="15"
              HorizontalAlignment="Center"
              Data="{Binding IconData}" />
          <TextBlock
              Grid.Column="1"
              Margin="8,0,0,0"
              FontSize="14"
              VerticalAlignment="Center"
              Text="{Binding Title}" />
          <TextBlock
              Grid.Column="2"
              Classes="nav-count"
              IsVisible="{Binding HasCount}"
              Text="{Binding CountText}" />
        </Grid>
      </RadioButton>
    </DataTemplate>
    <DataTemplate x:Key="TodayTaskRowTemplate" x:DataType="vm:TodayTaskRowViewModel">
      <Border Classes="interactive-row separated-row reorder-target task-row selectable-row"
          Classes.today-planned-row="{Binding IsPlanned}"
          Classes.today-in-progress-row="{Binding IsInProgress}"
          Classes.last="{Binding IsLast}"
          MinHeight="{StaticResource StandardRowHeight}">
        <Grid VerticalAlignment="Center" ColumnDefinitions="34,34,*,Auto,Auto,Auto,34">
          <Button Classes="drag-handle"
              Classes.today-planned-drag-handle="{Binding IsPlanned}"
              Classes.today-in-progress-drag-handle="{Binding IsInProgress}"
              AutomationProperties.AutomationId="{Binding ReorderAutomationId}"
              AutomationProperties.Name="{Binding ReorderAccessibleName}"
              AutomationProperties.HelpText="{Binding ReorderHelpText}">
            <Button.Flyout>
              <MenuFlyout Closed="OnReorderMenuClosed">
                <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" AutomationProperties.Name="{Binding MoveToTopAccessibleName}" />
                <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{Binding MoveUpAccessibleName}" />
                <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{Binding MoveDownAccessibleName}" />
                <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" AutomationProperties.Name="{Binding MoveToBottomAccessibleName}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <ToggleButton Grid.Column="1" Classes="completion-toggle"
              IsChecked="{Binding Task.IsComplete, Mode=OneWay}" Command="{Binding Task.ToggleCompletionCommand}"
              AutomationProperties.AutomationId="{Binding Task.CompletionAutomationId}"
              AutomationProperties.Name="{Binding Task.CompletionAccessibleName}" />
          <Button Grid.Column="2" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
              AutomationProperties.Name="{Binding Task.Title}" AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Task.Title}" />
              <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="{Binding Task.CategoryDisplay}" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="3" Classes="task-date" Text="{Binding Task.DateText}"
              AutomationProperties.Name="{Binding Task.DateAccessibleText}" />
          <Button Grid.Column="4" Classes="view-action" Margin="8,0" Content="{Binding MoveToOtherLaneLabel}"
              Command="{Binding MoveToOtherLaneCommand}" AutomationProperties.Name="{Binding MoveToOtherLaneAccessibleName}" />
          <TextBlock Grid.Column="5" Margin="8,0" VerticalAlignment="Center" FontSize="11"
              Foreground="{StaticResource QuietTextBrush}" Text="{Binding PositionText}" />
          <ToggleButton Grid.Column="6" Classes="today-toggle"
              IsChecked="{Binding Task.IsToday, Mode=OneWay}" Command="{Binding Task.ToggleTodayCommand}"
              AutomationProperties.AutomationId="{Binding Task.TodayAutomationId}"
              AutomationProperties.Name="{Binding Task.TodayAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="UpcomingTaskRowTemplate" x:DataType="vm:UpcomingTaskRowViewModel">
      <Border Classes="interactive-row separated-row task-row selectable-row upcoming-row"
          Classes.last="{Binding IsLast}"
          MinHeight="{StaticResource StandardRowHeight}">
        <Grid VerticalAlignment="Center" ColumnDefinitions="34,*,Auto,34">
          <ToggleButton Classes="completion-toggle"
              IsChecked="{Binding Task.IsComplete, Mode=OneWay}" Command="{Binding Task.ToggleCompletionCommand}"
              AutomationProperties.AutomationId="{Binding Task.CompletionAutomationId}"
              AutomationProperties.Name="{Binding Task.CompletionAccessibleName}" />
          <Button Grid.Column="1" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
              AutomationProperties.Name="{Binding Task.Title}" AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding Task.Title}" />
              <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="{Binding Task.CategoryDisplay}" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="2" Classes="task-date" Text="{Binding Task.DateText}"
              AutomationProperties.Name="{Binding Task.DateAccessibleText}" />
          <ToggleButton Grid.Column="3" Classes="today-toggle"
              IsChecked="{Binding Task.IsToday, Mode=OneWay}" Command="{Binding Task.ToggleTodayCommand}"
              AutomationProperties.AutomationId="{Binding Task.TodayAutomationId}"
              AutomationProperties.Name="{Binding Task.TodayAccessibleName}" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="228,*,320" RowDefinitions="64,*">
    <Border
        x:Name="TopBar"
        Grid.Row="0"
        Grid.ColumnSpan="3"
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource LineBrush}"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="228,*">
        <StackPanel
            Grid.Column="0"
            Margin="22,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="10">
          <Image
              x:Name="BrandMarkImage"
              Width="30"
              Height="30"
              Source="{StaticResource OrbitMarkImage}"
              Stretch="Uniform" />
          <TextBlock
              x:Name="BrandNameText"
              VerticalAlignment="Center"
              FontSize="18"
              FontWeight="Bold"
              Text="dot-orbit" />
        </StackPanel>
        <Border
            x:Name="TopBarStatus"
            Grid.Column="1"
            Classes="transient-status"
            Margin="24,0,20,0"
            MaxWidth="620"
            Padding="10,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsVisible="{Binding Work.HasMessage, FallbackValue=False}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
            <TextBlock
                x:Name="TopBarStatusIcon"
                Classes="transient-status-icon"
                VerticalAlignment="Center"
                Text="•" />
            <TextBlock
                x:Name="TopBarStatusMessage"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                FontSize="{StaticResource TypeSizeEyebrow}"
                Foreground="{StaticResource MutedTextBrush}"
                MaxLines="2"
                Text="{Binding Work.Message}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border
        Grid.Row="1"
        Grid.Column="0"
        IsEnabled="{Binding !Work.HasBlockingDialog, FallbackValue=True}"
        Padding="12,18"
        Background="{StaticResource SidebarBrush}"
        BorderBrush="{StaticResource LineBrush}"
        BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock
            x:Name="WorkspaceLabelText"
            Margin="12,4,12,8"
            FontSize="11"
            FontWeight="Bold"
            Foreground="{StaticResource QuietTextBrush}"
            LetterSpacing="1.4"
            Text="WORKSPACE" />

        <ItemsControl
            Grid.Row="1"
            ItemTemplate="{StaticResource NavigationItemTemplate}"
            ItemsSource="{Binding PrimaryNavigation}" />

        <Border
            Grid.Row="2"
            Padding="0,12,0,0"
            BorderBrush="{StaticResource LineSoftBrush}"
            BorderThickness="0,1,0,0">
          <StackPanel Spacing="4">
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{Binding BinNavigation}"
                ContentTemplate="{StaticResource NavigationItemTemplate}" />
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{Binding SettingsNavigation}"
                ContentTemplate="{StaticResource NavigationItemTemplate}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid
        x:Name="CurrentViewRegion"
        IsVisible="{Binding !ShowSettings}"
        IsEnabled="{Binding !Work.HasBlockingDialog, FallbackValue=True}"
        Grid.Row="1"
        Grid.Column="1"
        Margin="32,30,32,0"
        AutomationProperties.LiveSetting="Polite"
        RowDefinitions="Auto,28,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7">
          <TextBlock
              x:Name="CurrentViewEyebrowText"
              Classes="eyebrow"
              Text="PERSONAL WORKSPACE" />
          <TextBlock
              x:Name="CurrentViewTitleText"
              AutomationProperties.Name="Current view"
              FontSize="31"
              FontWeight="Bold"
              LetterSpacing="-1.2"
              Text="{Binding ViewTitle}" />
          <TextBlock
              x:Name="CurrentViewSubtitleText"
              FontSize="14"
              Foreground="{StaticResource MutedTextBrush}"
              Text="{Binding ViewSubtitle}"
              TextWrapping="Wrap" />
        </StackPanel>
        <Button
            x:Name="NewProjectButton"
            Grid.Column="1"
            Classes="primary-action"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="New project"
            Click="OnFocusInspector"
            Command="{Binding Work.NewProjectCommand}"
            Content="＋ New project"
            IsVisible="{Binding ShowProjects}" />
        <Button
            x:Name="NewTaskButton"
            Grid.Column="1"
            Classes="primary-action"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="New standalone task"
            Click="OnFocusInspector"
            Command="{Binding Work.NewTaskCommand}"
            Content="＋ New task"
            IsVisible="{Binding ShowBacklog}" />
        <Button
            x:Name="NewTodayTaskButton"
            Grid.Column="1"
            Classes="primary-action"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="New task in Today"
            Click="OnFocusInspector"
            Command="{Binding Work.NewTodayTaskCommand}"
            Content="＋ New task"
            IsVisible="{Binding ShowToday}" />
        <Button
            x:Name="NewCategoryButton"
            Grid.Column="1"
            Classes="primary-action"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="New category"
            Click="OnFocusInspector"
            Command="{Binding Work.NewCategoryCommand}"
            Content="＋ New category"
            IsVisible="{Binding ShowCategories}" />
      </Grid>

      <Border
          Grid.Row="2"
          Classes="empty-state"
          IsVisible="{Binding ShowEmpty}"
          Padding="42"
          VerticalAlignment="Top"
          CornerRadius="14">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <TextBlock
              x:Name="EmptyStateHeadingText"
              HorizontalAlignment="Center"
              FontSize="18"
              FontWeight="SemiBold"
              Text="{Binding EmptyStateHeading}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <TextBlock
              x:Name="EmptyStateBodyText"
              MaxWidth="440"
              HorizontalAlignment="Center"
              FontSize="14"
              Foreground="{StaticResource MutedTextBrush}"
              LineHeight="21"
              Text="{Binding EmptyStateBody}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowToday}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="eyebrow" VerticalAlignment="Center" Text="TODAY'S FOCUS" />
            <Button x:Name="TodayClearButton" Grid.Column="1" Classes="view-action"
                Content="Clear Today" Command="{Binding Work.ClearTodayCommand}"
                AutomationProperties.AutomationId="today-clear"
                AutomationProperties.Name="Clear incomplete Tasks from Today" />
          </Grid>
          <Border Classes="empty-state" IsVisible="{Binding Work.HasNoTodayTasks}" Padding="32">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Nothing planned for today" />
              <TextBlock MaxWidth="440" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                  Text="Use the star on any incomplete Task to add it to Planned." TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="6" IsVisible="{Binding Work.HasTodayTasks}">
            <TextBlock Classes="eyebrow" Margin="6,0" Text="PLANNED" />
            <Border x:Name="TodayPlannedPanel" Classes="list-panel">
              <ItemsControl ItemsSource="{Binding Work.TodayPlanned}" ItemTemplate="{StaticResource TodayTaskRowTemplate}" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding Work.HasTodayTasks}">
            <TextBlock Classes="eyebrow" Margin="6,0" Text="IN PROGRESS" />
            <Border x:Name="TodayInProgressPanel" Classes="list-panel">
              <ItemsControl ItemsSource="{Binding Work.TodayInProgress}" ItemTemplate="{StaticResource TodayTaskRowTemplate}" />
            </Border>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding Work.HasCompletedToday}">
            <TextBlock Classes="eyebrow" Margin="6,0" Text="COMPLETED TODAY" />
            <Border x:Name="CompletedTodayPanel" Classes="list-panel">
              <ItemsControl ItemsSource="{Binding Work.CompletedToday}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompletedTaskRowViewModel">
                    <Border Classes="interactive-row separated-row task-row selectable-row completed-today-row" Classes.last="{Binding IsLast}" MinHeight="{StaticResource StandardRowHeight}">
                      <Grid VerticalAlignment="Center" ColumnDefinitions="34,*,Auto">
                        <ToggleButton Classes="completion-toggle" IsChecked="{Binding Task.IsComplete, Mode=OneWay}"
                            Command="{Binding Task.ToggleCompletionCommand}" AutomationProperties.AutomationId="{Binding Task.CompletionAutomationId}"
                            AutomationProperties.Name="{Binding Task.CompletionAccessibleName}" />
                        <Button Grid.Column="1" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
                            AutomationProperties.Name="{Binding Task.Title}" AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Task.Title}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="{Binding Task.CategoryDisplay}" />
                          </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Classes="task-completion-date" Text="{Binding Task.CompletionDateText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Height="1" Opacity="0" IsHitTestVisible="False" IsVisible="{Binding ShowToday}"
          Text="{Binding Work.TodayAnnouncement}" AutomationProperties.LiveSetting="Polite" />
      <ScrollViewer x:Name="UpcomingView" Grid.Row="2" IsVisible="{Binding ShowUpcoming}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="14">
          <Border Classes="empty-state" IsVisible="{Binding Work.HasNoUpcoming}" Padding="44">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="No upcoming tasks" />
              <TextBlock MaxWidth="440" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                  Text="Overdue tasks and tasks due through the same weekday next week will appear here."
                  TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl x:Name="UpcomingGroups" ItemsSource="{Binding Work.UpcomingGroups}" IsVisible="{Binding Work.HasUpcoming}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:UpcomingTaskGroupViewModel">
                <StackPanel Spacing="6">
                  <TextBlock Classes="eyebrow" Margin="6,0" Text="{Binding Heading}" />
                  <Border Classes="list-panel">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource UpcomingTaskRowTemplate}" />
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowProjects}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="10">
          <Border
              Classes="empty-state"
              IsVisible="{Binding Work.HasNoProjects}"
              Padding="44">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="No projects yet" />
              <TextBlock MaxWidth="420" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" LineHeight="21" Text="Create a project when a piece of work needs more than one task." TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Work.Projects}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProjectRowViewModel">
                <Border
                    Classes="project-row reorder-target"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="10">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Classes="interactive-row expandable-header-row project-header-row selectable-row" Classes.expanded="{Binding IsExpanded}" Padding="10,8,12,8">
                      <Grid ColumnDefinitions="30,4,30,*,Auto,Auto">
                        <Button
                            Classes="drag-handle project-drag-handle"
                            AutomationProperties.AutomationId="{Binding ReorderAutomationId}"
                            AutomationProperties.Name="{Binding ReorderAccessibleName}"
                            AutomationProperties.HelpText="Drag to another Project, or activate for keyboard reorder actions.">
                          <Button.Flyout>
                            <MenuFlyout Closed="OnReorderMenuClosed">
                              <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" AutomationProperties.Name="{Binding MoveToTopAccessibleName}" />
                              <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{Binding MoveUpAccessibleName}" />
                              <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{Binding MoveDownAccessibleName}" />
                              <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" AutomationProperties.Name="{Binding MoveToBottomAccessibleName}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <ToggleButton
                            Grid.Column="2"
                            Classes="disclosure"
                            AutomationProperties.Name="{Binding ExpansionAccessibleName}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                        <Button
                            Grid.Column="3"
                            Classes="project-title row-title"
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding SelectCommand}">
                          <StackPanel Spacing="5">
                            <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="status-marker" Classes.not-started="{Binding IsNotStarted}" Classes.in-progress="{Binding IsInProgress}" Classes.complete="{Binding IsComplete}" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock Classes="status-marker" Classes.not-started="{Binding IsNotStarted}" Classes.in-progress="{Binding IsInProgress}" Classes.complete="{Binding IsComplete}" FontSize="12" Text="{Binding Status}" />
                              </StackPanel>
                              <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="·" />
                              <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ProgressText}" />
                              <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="·" />
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource QuietTextBrush}" />
                                <TextBlock MaxWidth="105" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                          <TextBlock MaxWidth="110" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                              Text="{Binding TargetText}" TextAlignment="Right" TextWrapping="Wrap"
                              AutomationProperties.Name="{Binding TargetAccessibleText}" />
                          <TextBlock IsVisible="{Binding IsOverdue}" Foreground="{StaticResource AmberBrush}"
                              FontSize="11" FontWeight="Bold" Text="⚠ Overdue" AutomationProperties.Name="Overdue" />
                          <TextBlock IsVisible="{Binding HasCompletionDate}"
                              FontSize="11" Foreground="{StaticResource SuccessBrush}" Text="{Binding CompletionDateText}" />
                        </StackPanel>
                        <Button Grid.Column="5" Classes="view-action task-row-action" Margin="8,0,0,0" Content="Archive"
                            Command="{Binding ArchiveCommand}"
                            AutomationProperties.AutomationId="{Binding ArchiveAutomationId}"
                            AutomationProperties.Name="{Binding ArchiveAccessibleName}" />
                      </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        IsVisible="{Binding IsExpanded}"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineSoftBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,7,10,10">
                      <StackPanel Spacing="0">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskRowViewModel">
                              <Border Classes="interactive-row separated-row reorder-target task-row selectable-row project-task-row" Classes.last="{Binding IsProjectLast}" MinHeight="{StaticResource CompactRowHeight}">
                                <Grid VerticalAlignment="Center" ColumnDefinitions="34,34,*,Auto,34,Auto">
                                  <Button Classes="drag-handle project-task-drag-handle" AutomationProperties.AutomationId="{Binding ProjectReorderAutomationId}"
                                      AutomationProperties.Name="{Binding ProjectReorderAccessibleName}"
                                      AutomationProperties.HelpText="Drag within this Project, or activate for keyboard reorder actions.">
                                    <Button.Flyout>
                                      <MenuFlyout Closed="OnReorderMenuClosed">
                                        <MenuItem Header="Move to top" Command="{Binding MoveProjectTaskToTopCommand}" AutomationProperties.Name="{Binding MoveProjectTaskToTopAccessibleName}" />
                                        <MenuItem Header="Move up" Command="{Binding MoveProjectTaskUpCommand}" AutomationProperties.Name="{Binding MoveProjectTaskUpAccessibleName}" />
                                        <MenuItem Header="Move down" Command="{Binding MoveProjectTaskDownCommand}" AutomationProperties.Name="{Binding MoveProjectTaskDownAccessibleName}" />
                                        <MenuItem Header="Move to bottom" Command="{Binding MoveProjectTaskToBottomCommand}" AutomationProperties.Name="{Binding MoveProjectTaskToBottomAccessibleName}" />
                                      </MenuFlyout>
                                    </Button.Flyout>
                                  </Button>
                                  <ToggleButton Grid.Column="1" Classes="completion-toggle"
                                      IsChecked="{Binding IsComplete, Mode=OneWay}" Command="{Binding ToggleCompletionCommand}"
                                      IsEnabled="{Binding !IsArchived}"
                                      AutomationProperties.AutomationId="{Binding CompletionAutomationId}"
                                      AutomationProperties.Name="{Binding CompletionAccessibleName}" />
                                  <ToggleButton Grid.Column="4" Classes="today-toggle" IsVisible="{Binding !IsComplete}"
                                      IsChecked="{Binding IsToday, Mode=OneWay}" Command="{Binding ToggleTodayCommand}"
                                      AutomationProperties.AutomationId="{Binding TodayAutomationId}"
                                      AutomationProperties.Name="{Binding TodayAccessibleName}" />
                                  <Button
                                      Grid.Column="2"
                                      Classes="task-title project-task-title row-title"
                                      AutomationProperties.Name="{Binding Title}"
                                      AutomationProperties.ItemStatus="{Binding CategoryDisplay}"
                                      Command="{Binding SelectCommand}">
                                    <StackPanel Spacing="3">
                                      <TextBlock FontSize="14" Text="{Binding Title}" />
                                      <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="{Binding CategoryDisplay}" />
                                    </StackPanel>
                                  </Button>
                                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Classes="task-date" Text="{Binding DateText}"
                                        AutomationProperties.Name="{Binding DateAccessibleText}" />
                                    <TextBlock Classes="task-completion-date" IsVisible="{Binding HasCompletionDate}"
                                        Text="{Binding CompletionDateText}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="4" Grid.ColumnSpan="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                      Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsArchived}">
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Archived" />
                                    <Button Classes="view-action task-row-action" Content="Restore" Command="{Binding RestoreCommand}"
                                        AutomationProperties.AutomationId="{Binding RestoreAutomationId}"
                                        AutomationProperties.Name="{Binding RestoreAccessibleName}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,7,0,0" Background="{StaticResource PanelInputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                          <Grid ColumnDefinitions="30,*">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="17" Text="＋" />
                            <TextBox
                                Grid.Column="1"
                                Classes="quick-add"
                                Background="Transparent"
                                BorderThickness="0"
                                Text="{Binding QuickTitle, Mode=TwoWay}"
                                PlaceholderText="Quick add task"
                                AutomationProperties.Name="Quick add task"
                                AutomationProperties.HelpText="Enter or Tab creates a task. Escape clears the title. Tab on an empty field moves on."
                                KeyDown="OnQuickAddKeyDown" />
                          </Grid>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowBacklog}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="10">
          <Border Classes="list-panel">
            <Grid ColumnDefinitions="190,10,*">
              <ComboBox
                  ItemsSource="{Binding Work.BacklogCategories}"
                  SelectedItem="{Binding Work.BacklogQuickCategory, Mode=TwoWay}"
                  PlaceholderText="Choose category"
                  AutomationProperties.Name="Standalone task category">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox
                  x:Name="BacklogQuickTitle"
                  Grid.Column="2"
                  Classes="inspector-field backlog-quick-add"
                  Text="{Binding Work.BacklogQuickTitle, Mode=TwoWay}"
                  PlaceholderText="Quick add standalone task"
                  AutomationProperties.Name="Quick add standalone task"
                  AutomationProperties.AutomationId="backlog-quick-title"
                  AutomationProperties.HelpText="Choose a category. Enter or Tab creates a task. Escape clears the title. Tab on an empty field moves on."
                  KeyDown="OnBacklogQuickAddKeyDown" />
            </Grid>
          </Border>
        <Border x:Name="BacklogListPanel" Classes="list-panel">
          <ItemsControl x:Name="BacklogItems" ItemsSource="{Binding Work.Backlog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskRowViewModel">
                <Border Classes="interactive-row separated-row reorder-target task-row selectable-row backlog-row" Classes.last="{Binding IsLast}" MinHeight="{StaticResource StandardRowHeight}">
                  <Grid VerticalAlignment="Center" ColumnDefinitions="34,34,*,Auto,Auto,34">
                    <Button
                        Classes="drag-handle backlog-drag-handle"
                        AutomationProperties.AutomationId="{Binding ReorderAutomationId}"
                        AutomationProperties.Name="{Binding ReorderAccessibleName}"
                        AutomationProperties.HelpText="Drag to another Backlog row, or activate for keyboard reorder actions.">
                      <Button.Flyout>
                        <MenuFlyout Closed="OnReorderMenuClosed">
                          <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" AutomationProperties.Name="{Binding MoveToTopAccessibleName}" />
                          <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{Binding MoveUpAccessibleName}" />
                          <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{Binding MoveDownAccessibleName}" />
                          <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" AutomationProperties.Name="{Binding MoveToBottomAccessibleName}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <ToggleButton Grid.Column="1" Classes="completion-toggle"
                        IsChecked="{Binding IsComplete, Mode=OneWay}" Command="{Binding ToggleCompletionCommand}"
                        AutomationProperties.AutomationId="{Binding CompletionAutomationId}"
                        AutomationProperties.Name="{Binding CompletionAccessibleName}" />
                    <ToggleButton Grid.Column="5" Classes="today-toggle" IsVisible="{Binding !IsComplete}"
                        IsChecked="{Binding IsToday, Mode=OneWay}" Command="{Binding ToggleTodayCommand}"
                        AutomationProperties.AutomationId="{Binding TodayAutomationId}"
                        AutomationProperties.Name="{Binding TodayAccessibleName}" />
                    <Button
                        Grid.Column="2"
                        Classes="task-title backlog-task-title row-title"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Title}"
                        AutomationProperties.ItemStatus="{Binding CategoryDisplay}">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding CategoryDisplay}" Foreground="{StaticResource QuietTextBrush}" FontSize="12" />
                      </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="3" Classes="task-date" Text="{Binding DateText}"
                        AutomationProperties.Name="{Binding DateAccessibleText}" />
                    <TextBlock Grid.Column="4" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource QuietTextBrush}" FontSize="11" Text="{Binding PositionText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Height="1" Opacity="0" IsHitTestVisible="False" IsVisible="{Binding ShowBacklog}"
          Text="{Binding Work.ReorderAnnouncement}" AutomationProperties.LiveSetting="Polite" />
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowCategories}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="10">
          <ItemsControl ItemsSource="{Binding Work.CategoryGroups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryGroupViewModel">
                <Border Classes="category-row reorder-target" Background="{StaticResource PanelBrush}" CornerRadius="10">
                  <Grid RowDefinitions="Auto,Auto">
                    <Border Classes="interactive-row expandable-header-row category-header-row selectable-row"
                        Classes.expanded="{Binding IsExpanded}" Padding="10,8,12,8">
                      <Grid ColumnDefinitions="30,4,30,*,Auto">
                        <Button Classes="drag-handle category-drag-handle"
                            AutomationProperties.AutomationId="{Binding ReorderAutomationId}"
                            AutomationProperties.Name="{Binding ReorderAccessibleName}"
                            AutomationProperties.HelpText="Drag to another Category, or activate for keyboard reorder actions.">
                          <Button.Flyout>
                            <MenuFlyout Closed="OnReorderMenuClosed">
                              <MenuItem Header="Move to top" Command="{Binding MoveToTopCommand}" AutomationProperties.Name="{Binding MoveToTopAccessibleName}" />
                              <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{Binding MoveUpAccessibleName}" />
                              <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{Binding MoveDownAccessibleName}" />
                              <MenuItem Header="Move to bottom" Command="{Binding MoveToBottomCommand}" AutomationProperties.Name="{Binding MoveToBottomAccessibleName}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                        <ToggleButton Grid.Column="2" Classes="disclosure"
                            AutomationProperties.Name="{Binding ExpansionAccessibleName}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay}" />
                        <Button Grid.Column="3" Classes="project-title row-title" Command="{Binding SelectCommand}"
                            AutomationProperties.AutomationId="{Binding SelectionAutomationId}"
                            AutomationProperties.Name="{Binding SelectionAccessibleName}">
                          <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding Name}" />
                        </Button>
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}" Text="{Binding Summary}" />
                      </Grid>
                    </Border>
                    <Border Grid.Row="1" IsVisible="{Binding IsExpanded}" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,0" Padding="10">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="eyebrow" Text="PROJECTS" />
                        <ItemsControl ItemsSource="{Binding Projects}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryProjectRowViewModel">
                              <Border Classes="interactive-row separated-row selectable-row category-project-row" Classes.last="{Binding IsLast}"
                                  HorizontalAlignment="Stretch" MinHeight="{StaticResource StandardRowHeight}">
                                <Button Classes="project-title row-title" Command="{Binding Project.SelectCommand}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{Binding Project.Title}" AutomationProperties.ItemStatus="{Binding Project.AccessibleStatus}">
                                  <Grid ColumnDefinitions="*,12,Auto">
                                    <TextBlock Text="{Binding Project.Title}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" TextAlignment="Right" FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}" Text="{Binding Project.ProgressText}" />
                                  </Grid>
                                </Button>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding !HasProjects}" Foreground="{StaticResource QuietTextBrush}" Text="No projects" />
                        <TextBlock Classes="eyebrow" Margin="0,6,0,0" Text="STANDALONE TASKS" />
                        <ItemsControl ItemsSource="{Binding StandaloneTasks}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryTaskRowViewModel">
                              <Border Classes="interactive-row separated-row task-row selectable-row category-task-row" Classes.last="{Binding IsLast}" MinHeight="{StaticResource StandardRowHeight}">
                                <Grid VerticalAlignment="Center" ColumnDefinitions="34,*,Auto,34">
                                  <ToggleButton Classes="completion-toggle"
                                      IsChecked="{Binding Task.IsComplete, Mode=OneWay}" Command="{Binding Task.ToggleCompletionCommand}"
                                      AutomationProperties.AutomationId="{Binding Task.CompletionAutomationId}"
                                      AutomationProperties.Name="{Binding Task.CompletionAccessibleName}" />
                                  <ToggleButton Grid.Column="3" Classes="today-toggle" IsVisible="{Binding !Task.IsComplete}"
                                      IsChecked="{Binding Task.IsToday, Mode=OneWay}" Command="{Binding Task.ToggleTodayCommand}"
                                      AutomationProperties.AutomationId="{Binding Task.TodayAutomationId}"
                                      AutomationProperties.Name="{Binding Task.TodayAccessibleName}" />
                                  <Button Grid.Column="1" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
                                      AutomationProperties.Name="{Binding Task.Title}" AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
                                    <StackPanel Spacing="3">
                                      <TextBlock Text="{Binding Task.Title}" />
                                      <TextBlock Text="{Binding Task.CategoryDisplay}" Foreground="{StaticResource QuietTextBrush}" FontSize="12" />
                                    </StackPanel>
                                  </Button>
                                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Classes="task-date" Text="{Binding Task.DateText}"
                                        AutomationProperties.Name="{Binding Task.DateAccessibleText}" />
                                    <TextBlock Classes="task-completion-date" IsVisible="{Binding Task.HasCompletionDate}"
                                        Text="{Binding Task.CompletionDateText}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding !HasStandaloneTasks}" Foreground="{StaticResource QuietTextBrush}" Text="No standalone tasks" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Height="1" Opacity="0" IsHitTestVisible="False" IsVisible="{Binding ShowCategories}"
          Text="{Binding Work.ReorderAnnouncement}" AutomationProperties.LiveSetting="Polite" />
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowCompleted}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="10">
          <Border Classes="list-panel">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Archive older completed Tasks" />
                <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                    Text="{Binding Work.BulkArchiveThresholdSummary}"
                    AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="76" VerticalAlignment="Center"
                  ItemsSource="{Binding Work.BulkArchiveThresholdChoices}"
                  SelectedItem="{Binding Work.BulkArchiveCompletedAgeDays, Mode=TwoWay}"
                  AutomationProperties.AutomationId="bulk-archive-threshold"
                  AutomationProperties.Name="Completed age threshold in calendar days" />
              <Button Grid.Column="2" Classes="view-action" VerticalAlignment="Center"
                  Content="Archive Tasks" Command="{Binding Work.RequestBulkTaskArchiveCommand}"
                  IsEnabled="{Binding Work.CanBulkArchive}"
                  AutomationProperties.AutomationId="bulk-archive-request"
                  AutomationProperties.Name="Archive older completed Tasks" />
            </Grid>
          </Border>
          <Border Classes="empty-state" IsVisible="{Binding Work.HasNoCompleted}" Padding="44">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="No completed tasks yet" />
              <TextBlock MaxWidth="420" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                  Text="Tasks you complete will appear here so they can be reviewed, archived, or reopened."
                  TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="CompletedListPanel" Classes="list-panel" IsVisible="{Binding Work.HasCompleted}">
            <ItemsControl ItemsSource="{Binding Work.CompletedGroups}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CompletedTaskGroupViewModel">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Margin="6,4" Text="{Binding Heading}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompletedTaskRowViewModel">
                          <Border Classes="interactive-row separated-row task-row selectable-row completed-row" Classes.last="{Binding IsLast}" MinHeight="{StaticResource StandardRowHeight}">
                            <Grid VerticalAlignment="Center" ColumnDefinitions="34,*,Auto,Auto">
                              <ToggleButton Classes="completion-toggle"
                                  IsChecked="{Binding Task.IsComplete, Mode=OneWay}" Command="{Binding Task.ToggleCompletionCommand}"
                                  AutomationProperties.AutomationId="{Binding Task.CompletionAutomationId}"
                                  AutomationProperties.Name="{Binding Task.CompletionAccessibleName}" />
                              <Button Grid.Column="1" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
                                  AutomationProperties.Name="{Binding Task.Title}" AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{Binding Task.Title}" />
                                  <TextBlock Text="{Binding Task.CategoryDisplay}" Foreground="{StaticResource QuietTextBrush}" FontSize="12" />
                                </StackPanel>
                              </Button>
                              <TextBlock Grid.Column="2" Classes="task-completion-date" Text="{Binding Task.CompletionDateText}" />
                              <Button Grid.Column="3" Classes="view-action task-row-action" Margin="8,0,0,0"
                                  Content="Archive" Command="{Binding Task.ArchiveCommand}"
                                  AutomationProperties.AutomationId="{Binding Task.ArchiveAutomationId}"
                                  AutomationProperties.Name="{Binding Task.ArchiveAccessibleName}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="2" IsVisible="{Binding ShowArchive}">
        <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="10">
          <Border Classes="empty-state" IsVisible="{Binding Work.HasNoArchived}" Padding="44">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Your archive is empty" />
              <TextBlock MaxWidth="420" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                  Text="Projects and Tasks you archive will remain available to restore here."
                  TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Work.ArchiveGroups}" IsVisible="{Binding Work.HasArchived}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ArchivedWorkGroupViewModel">
                <StackPanel Spacing="4">
                  <TextBlock Classes="eyebrow" Margin="6,4" Text="{Binding Heading}" />
                  <Border Classes="list-panel">
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchivedWorkRowViewModel">
                          <Border Classes="interactive-row separated-row archive-row"
                              Classes.task-row="{Binding IsTask}" Classes.selectable-row="{Binding IsTask}"
                              Classes.last="{Binding IsLast}"
                              MinHeight="{StaticResource StandardRowHeight}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                              <StackPanel IsVisible="{Binding IsProject}" VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Project.Title}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource QuietTextBrush}" Text="{Binding Project.Summary}" />
                              </StackPanel>
                              <Button IsVisible="{Binding IsTask}" Classes="task-title row-title" Command="{Binding Task.SelectCommand}"
                                  AutomationProperties.Name="{Binding Task.Title}"
                                  AutomationProperties.ItemStatus="{Binding Task.CategoryDisplay}">
                                <StackPanel Spacing="3">
                                  <TextBlock Text="{Binding Task.Title}" />
                                  <TextBlock Text="{Binding Task.CategoryDisplay}" Foreground="{StaticResource QuietTextBrush}" FontSize="12" />
                                </StackPanel>
                              </Button>
                              <TextBlock Grid.Column="1" Classes="task-completion-date" IsVisible="{Binding IsTask}"
                                  Text="{Binding Task.CompletionDateText}" />
                              <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource MutedTextBrush}"
                                  Text="Archived Project" IsVisible="{Binding IsProject}" />
                              <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                  Foreground="{StaticResource MutedTextBrush}"
                                  Text="Archived Task" IsVisible="{Binding IsTask}" />
                              <Button Grid.Column="3" Classes="view-action task-row-action" Margin="8,0,0,0"
                                  IsVisible="{Binding IsProject}"
                                  Content="Restore" Command="{Binding Project.RestoreCommand}"
                                  AutomationProperties.AutomationId="{Binding Project.RestoreAutomationId}"
                                  AutomationProperties.Name="{Binding Project.RestoreAccessibleName}" />
                              <Button Grid.Column="3" Classes="view-action task-row-action" Margin="8,0,0,0"
                                  IsVisible="{Binding IsTask}"
                                  Content="Restore" Command="{Binding Task.RestoreCommand}"
                                  AutomationProperties.AutomationId="{Binding Task.RestoreAutomationId}"
                                  AutomationProperties.Name="{Binding Task.RestoreAccessibleName}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ScrollViewer
        x:Name="SettingsRegion"
        Grid.Row="1"
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Margin="32,30,32,0"
        IsVisible="{Binding ShowSettings}">
      <StackPanel Margin="{StaticResource ScrollContentInset}" Spacing="24">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="WORKSPACE" />
          <TextBlock FontSize="31" FontWeight="Bold" LetterSpacing="-1.2" Text="Settings"
              AutomationProperties.Name="Current view" />
          <TextBlock FontSize="14" Foreground="{StaticResource MutedTextBrush}"
              Text="Manage reusable workspace data and recovery options." />
        </StackPanel>

        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock FontSize="20" FontWeight="Bold" Text="Participants" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                Text="Reusable initials or nicknames that can be associated with Tasks." />
          </StackPanel>
          <Border x:Name="SettingsParticipantsEmpty" Classes="empty-state"
              IsVisible="{Binding Settings.HasNoParticipants}" Padding="32">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
              <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                  Text="No Participants yet" TextAlignment="Center" />
              <TextBlock MaxWidth="440" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                  Text="Create one from a Task's Participant picker." TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="SettingsParticipantsList" Classes="list-panel"
              IsVisible="{Binding Settings.HasParticipants}">
              <ItemsControl ItemsSource="{Binding Settings.Participants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParticipantSettingViewModel">
                    <Border Classes="interactive-row separated-row" Classes.last="{Binding IsLast}" MinHeight="54">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding IsReadOnly}" Spacing="2">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                          <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding UsageText}" />
                          <TextBlock Classes="validation-message" Text="{Binding ValidationMessage}"
                              IsVisible="{Binding HasValidationError}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding IsEditing}" Spacing="3">
                          <TextBox Classes="inspector-field" Classes.error="{Binding HasValidationError}"
                              Text="{Binding DraftLabel, Mode=TwoWay}"
                              KeyDown="OnParticipantRenameKeyDown"
                              AutomationProperties.AutomationId="{Binding LabelAutomationId}"
                              AutomationProperties.Name="Participant label"
                              AutomationProperties.HelpText="{Binding ValidationMessage}" />
                          <TextBlock Classes="validation-message" Text="{Binding ValidationMessage}"
                              IsVisible="{Binding HasValidationError}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="view-action" Content="Rename"
                            IsVisible="{Binding IsReadOnly}" Command="{Binding BeginRenameCommand}"
                            AutomationProperties.AutomationId="{Binding RenameAutomationId}"
                            AutomationProperties.Name="{Binding RenameAccessibleName}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                          <Button Classes="primary-action" Content="Save" Command="{Binding SaveRenameCommand}"
                              AutomationProperties.Name="Save Participant label" />
                          <Button Classes="view-action" Content="Cancel" Command="{Binding CancelRenameCommand}"
                              AutomationProperties.Name="Cancel Participant rename" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="view-action" Content="Delete"
                            IsVisible="{Binding IsReadOnly}" Command="{Binding DeleteCommand}"
                            AutomationProperties.AutomationId="{Binding DeleteAutomationId}"
                            AutomationProperties.Name="{Binding DeleteAccessibleName}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <StackPanel Spacing="4">
            <TextBlock FontSize="20" FontWeight="Bold" Text="Recovery" />
            <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                Text="Create and restore portable encrypted recovery points." />
          </StackPanel>
          <Border Classes="list-panel">
            <Border Classes="interactive-row separated-row last" MinHeight="54">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="Encrypted recovery" />
                  <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                      Text="Choose automatic recovery storage, create a recovery point, or restore one." />
                </StackPanel>
                <Button x:Name="SettingsRecoveryButton" Grid.Column="1" Classes="view-action"
                    Content="Open recovery settings" Click="OnOpenRecovery"
                    AutomationProperties.AutomationId="settings-recovery-open"
                    AutomationProperties.Name="Open recovery settings" />
              </Grid>
            </Border>
          </Border>

          <TextBlock Margin="0,12,0,0" FontSize="20" FontWeight="Bold" Text="Security" />
          <TextBlock
              Foreground="{StaticResource MutedTextBrush}"
              Text="Change the passphrase used to unlock the working workspace. Existing recovery points keep the passphrase that created them."
              TextWrapping="Wrap" />
          <Border
              x:Name="PassphraseChangedConfirmation"
              Padding="14,11"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource SuccessBrush}"
              BorderThickness="1"
              CornerRadius="8"
              IsVisible="{Binding Settings.HasSecurityConfirmation}"
              AutomationProperties.LiveSetting="Polite"
              AutomationProperties.Name="Passphrase changed confirmation">
            <TextBlock
                Foreground="{StaticResource SuccessBrush}"
                FontWeight="SemiBold"
                Text="{Binding Settings.SecurityConfirmation}"
                TextWrapping="Wrap" />
          </Border>
          <Border Classes="list-panel">
            <Grid Margin="16,14" ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Workspace passphrase" />
                <TextBlock
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="The current passphrase is required and a validated recovery point is created first."
                    TextWrapping="Wrap" />
              </StackPanel>
              <Button
                  x:Name="SettingsPassphraseButton"
                  Grid.Column="1"
                  Classes="view-action"
                  Content="Change passphrase"
                  AutomationProperties.Name="Change workspace passphrase"
                  Click="OnOpenPassphraseRotation" />
            </Grid>
          </Border>
        </StackPanel>
        <TextBlock Height="1" Opacity="0" Text="{Binding Settings.Announcement}"
            AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>

    <Border
        x:Name="InspectorRegion"
        IsVisible="{Binding !ShowSettings}"
        IsEnabled="{Binding !Work.HasBlockingDialog, FallbackValue=True}"
        Grid.Row="1"
        Grid.Column="2"
        Padding="22"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource LineBrush}"
        BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
      <TextBlock
          Grid.RowSpan="2"
          IsVisible="{Binding Work.HasNoInspector, FallbackValue=True}"
          x:Name="InspectorEmptyText"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="14"
          Foreground="{StaticResource QuietTextBrush}"
          LineHeight="19"
          Text="Select a project, task, or category&#x0a;to see its details"
          TextAlignment="Center" />
      <Grid Grid.Row="0" Margin="0,0,32,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
          IsVisible="{Binding Work.HasInspector}">
            <Border Padding="8,4" Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
              <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Work.InspectorHeading}" />
            </Border>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                IsVisible="{Binding Work.ShowAutosaveStatus}" Text="{Binding Work.AutosaveStatus}"
                FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                AutomationProperties.Name="Autosave status" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" Classes="view-action" Content="Retry"
                IsVisible="{Binding Work.HasAutosaveError}" Command="{Binding Work.RetryAutosaveCommand}"
                AutomationProperties.Name="Retry automatic save" />
      </Grid>
      <ScrollViewer Grid.Row="1" IsVisible="{Binding Work.HasInspector}">
        <StackPanel Margin="{StaticResource InspectorScrollContentInset}" Spacing="0">
          <TextBox
              x:Name="DraftTitle"
              Classes="inspector-title"
              Classes.error="{Binding Work.HasTitleValidationError}"
              Margin="0,9,0,0"
              Text="{Binding Work.Title, Mode=TwoWay}"
              AutomationProperties.Name="{Binding Work.TitleAutomationName}"
              AutomationProperties.HelpText="{Binding Work.TitleValidationMessage}" />
          <TextBlock Classes="validation-message" Margin="7,4,0,0"
              Text="{Binding Work.TitleValidationMessage}"
              IsVisible="{Binding Work.HasTitleValidationError}" />
          <TextBlock
              Margin="0,2,0,0"
              IsVisible="{Binding Work.ShowProjectSummary}"
              Text="{Binding Work.ProjectSummary}"
              TextWrapping="Wrap"
              FontSize="12"
              Foreground="{StaticResource MutedTextBrush}" />

          <StackPanel IsVisible="{Binding Work.ShowWorkInspector}">
          <Border Margin="0,22,0,0" Padding="0,20,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="9">
              <TextBlock Classes="inspector-label" Text="DESCRIPTION · MARKDOWN" />
              <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="view-action" Content="Copy rendered" Click="OnCopyRendered"
                    IsEnabled="{Binding Work.HasRenderedDescription}" AutomationProperties.Name="Copy rendered description" />
              </StackPanel>
              <views:MarkdownPreviewSurface
                  x:Name="MarkdownPreviewButton"
                  Classes="markdown-preview"
                  IsVisible="{Binding Work.ShowMarkdownPreview}"
                  Activated="OnMarkdownPreviewActivated"
                  AutomationProperties.ControlTypeOverride="Button"
                  AutomationProperties.Name="{Binding Work.MarkdownPreviewAutomationName}">
                <views:MarkdownPreview Document="{Binding Work.RenderedDescription}" />
              </views:MarkdownPreviewSurface>
              <TextBox
                  x:Name="MarkdownSource"
                  Classes="inspector-field"
                  IsVisible="{Binding Work.ShowMarkdownEditor}"
                  Text="{Binding Work.Description, Mode=TwoWay}"
                  AcceptsReturn="True"
                  MinHeight="122"
                  LineHeight="20"
                  TextWrapping="Wrap"
                  LostFocus="OnMarkdownSourceLostFocus"
                  AutomationProperties.Name="Description, Markdown source" />
            </StackPanel>
          </Border>

          <Border Margin="0,22,0,0" Padding="0,20,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="14">
              <StackPanel Spacing="9">
                <TextBlock Classes="inspector-label" Text="DATE" />
                <StackPanel Spacing="4">
                  <views:InspectorDatePicker
                      x:Name="DraftDate"
                      Classes="inspector-field"
                      Classes.error="{Binding Work.HasDateValidationError}"
                      SelectedDateFormat="Custom"
                      CustomDateFormatString="yyyy-MM-dd"
                      Text="{Binding Work.Date, Mode=OneWay}"
                      RawText="{Binding Work.Date, Mode=TwoWay}"
                      PlaceholderText="YYYY-MM-DD"
                      DateValidationError="OnDateValidationError"
                      CalendarOpened="OnCalendarDateOpened"
                      CalendarClosed="OnCalendarDateCommitted"
                      AutomationProperties.Name="{Binding Work.DateLabel}"
                      AutomationProperties.HelpText="{Binding Work.DateValidationMessage}" />
                  <TextBlock Classes="validation-message" Margin="7,0,0,0"
                      Text="{Binding Work.DateValidationMessage}"
                      IsVisible="{Binding Work.HasDateValidationError}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="9">
                <TextBlock Classes="inspector-label" Text="{Binding Work.InspectorMetaLabel}" />
                <Border MinHeight="38" Padding="10,8" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                  <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Work.InspectorMetaValue}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Margin="0,12,0,0" Padding="10,8" Background="{StaticResource PanelRaisedBrush}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
              IsVisible="{Binding Work.ShowTaskCompletionDate}">
            <TextBlock Text="{Binding Work.TaskCompletionDateText}"
                AutomationProperties.Name="{Binding Work.TaskCompletionDateAccessibleText}"
                Foreground="{StaticResource SuccessBrush}" />
          </Border>

          <Border Margin="0,22,0,0" Padding="0,20,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="9">
              <TextBlock Classes="inspector-label" Text="CATEGORY" />
              <ComboBox
                  Classes="inspector-field"
                  ItemsSource="{Binding Work.Categories}"
                  SelectedItem="{Binding Work.Category, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Category">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Work.CategoryHint}" FontSize="11" Foreground="{StaticResource QuietTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              IsVisible="{Binding Work.ShowParticipants}">
            <StackPanel Spacing="9">
              <TextBlock Classes="inspector-label" Text="PARTICIPANTS" />
              <TextBlock Text="{x:Static vm:ProjectCaptureViewModel.ParticipantGuidance}" FontSize="11"
                  Foreground="{StaticResource QuietTextBrush}" TextWrapping="Wrap"
                  AutomationProperties.Name="Participant guidance" />
              <ItemsControl ItemsSource="{Binding Work.SelectedParticipants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParticipantDraftViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                      <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                      <Button Grid.Column="1" Classes="view-action" Content="Remove" Command="{Binding RemoveCommand}"
                          AutomationProperties.AutomationId="{Binding RemoveAutomationId}"
                          AutomationProperties.Name="{Binding RemoveAccessibleName}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="ParticipantPicker" Classes="inspector-field"
                    Classes.error="{Binding Work.HasParticipantSelectionError}"
                    ItemsSource="{Binding Work.AvailableParticipants}" SelectedItem="{Binding Work.ParticipantToAdd, Mode=TwoWay}"
                    AutomationProperties.AutomationId="participant-picker"
                    AutomationProperties.Name="Choose or create Participant"
                    AutomationProperties.HelpText="{Binding Work.ParticipantSelectionMessage}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParticipantChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Classes="view-action" Content="Add" Command="{Binding Work.AddParticipantCommand}"
                    IsVisible="{Binding Work.ShowExistingParticipantAction}"
                    AutomationProperties.Name="Add existing Participant to Task" />
              </Grid>
              <TextBlock Classes="validation-message" Text="{Binding Work.ParticipantSelectionMessage}"
                  IsVisible="{Binding Work.HasParticipantSelectionError}" AutomationProperties.LiveSetting="Polite" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding Work.ShowNewParticipantEntry}">
                <TextBox x:Name="NewParticipantLabel" Classes="inspector-field"
                    Classes.error="{Binding Work.HasNewParticipantValidationError}"
                    Text="{Binding Work.NewParticipantLabel, Mode=TwoWay}"
                    KeyDown="OnNewParticipantKeyDown"
                    AutomationProperties.AutomationId="new-participant-label"
                    AutomationProperties.Name="New Participant label"
                    AutomationProperties.HelpText="{Binding Work.NewParticipantValidationMessage}" />
                <Button Grid.Column="1" Classes="view-action" Content="Add"
                    Command="{Binding Work.AddNewParticipantCommand}"
                    AutomationProperties.Name="Add new Participant to Task" />
                <Button Grid.Column="2" Classes="view-action" Content="Cancel"
                    Command="{Binding Work.CancelNewParticipantCommand}"
                    AutomationProperties.Name="Cancel new Participant" />
              </Grid>
              <TextBlock Classes="validation-message" Text="{Binding Work.NewParticipantValidationMessage}"
                  IsVisible="{Binding Work.HasNewParticipantValidationError}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Height="1" Opacity="0" Text="{Binding Work.ParticipantAnnouncement}"
                  AutomationProperties.AutomationId="participant-announcement" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              IsVisible="{Binding Work.ShowTaskContext}">
            <StackPanel Spacing="9">
              <TextBlock Classes="inspector-label" Text="TASK CONTEXT" />
              <ComboBox Classes="inspector-field" ItemsSource="{Binding Work.TaskContextChoices}"
                  SelectedItem="{Binding Work.TaskContextTarget, Mode=TwoWay}"
                  AutomationProperties.Name="Task context">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TaskContextChoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="view-action" Content="{Binding Work.TaskContextActionLabel}"
                  x:Name="ChangeTaskContextButton"
                  IsVisible="{Binding Work.ShowTaskContextAction}"
                  Command="{Binding Work.ChangeTaskContextCommand}" IsEnabled="{Binding Work.CanChangeTaskContext}"
                  AutomationProperties.Name="{Binding Work.TaskContextActionLabel}" />
              <TextBlock FontSize="11" Foreground="{StaticResource QuietTextBrush}" TextWrapping="Wrap"
                  IsVisible="{Binding Work.ShowTaskContextAction}"
                  Text="Context changes are immediate actions. Unsaved inspector edits are resolved first." />
            </StackPanel>
          </Border>
          </StackPanel>

          <Button Margin="0,22,0,0" Classes="view-action" Content="Delete category"
              Command="{Binding Work.DeleteCategoryCommand}" IsVisible="{Binding Work.ShowCategoryDelete}"
              AutomationProperties.AutomationId="category-delete" AutomationProperties.Name="Delete category" />

          <Grid x:Name="InspectorActions" Margin="0,24,0,0" ColumnDefinitions="*,8,*"
              IsVisible="{Binding Work.ShowExplicitInspectorActions}">
            <Button
                Classes="primary-action"
                Content="{Binding Work.SaveLabel}"
                Command="{Binding Work.SaveCommand}"
                AutomationProperties.Name="{Binding Work.SaveLabel}" />
            <Button
                Grid.Column="2"
                Classes="view-action"
                Content="Cancel"
                Command="{Binding Work.CancelCommand}"
                Click="OnFocusInspector"
                AutomationProperties.Name="Cancel editing" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="decision-overlay" IsVisible="{Binding Work.NeedsDecision}">
      <StackPanel Width="470" Spacing="16" AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Work.DecisionHeading}" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="{Binding Work.DecisionBody}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="GuardSave" Classes="primary-action" Content="{Binding Work.DecisionSaveLabel}" Command="{Binding Work.SaveAndLeaveCommand}" AutomationProperties.Name="{Binding Work.DecisionSaveLabel}" />
          <Button Classes="view-action" Content="Discard and leave" Command="{Binding Work.DiscardAndLeaveCommand}" AutomationProperties.Name="Discard changes and leave" />
          <Button Classes="view-action" Content="Stay" Command="{Binding Work.StayCommand}" AutomationProperties.Name="Stay and keep editing" Click="OnFocusInspector" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="decision-overlay" IsVisible="{Binding Work.NeedsCategoryReplacement}">
      <StackPanel Width="470" Spacing="16" AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Work.CategoryDeleteHeading}" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="This Category is in use. Choose the Category that will replace it for every Project, standalone Task, and override." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox x:Name="CategoryReplacement" Classes="inspector-field"
            ItemsSource="{Binding Work.CategoryReplacementChoices}" SelectedItem="{Binding Work.CategoryReplacement, Mode=TwoWay}"
            AutomationProperties.Name="Replacement category">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CategoryChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Classes="primary-action" Content="Replace and delete" Command="{Binding Work.ConfirmDeleteCategoryCommand}" AutomationProperties.Name="Replace references and delete category" />
          <Button Classes="view-action" Content="Cancel" Command="{Binding Work.CancelDeleteCategoryCommand}" AutomationProperties.Name="Cancel category deletion" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="decision-overlay" IsVisible="{Binding Work.NeedsArchiveConfirmation}">
      <StackPanel Width="470" Spacing="16" AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Work.ArchiveConfirmationHeading}" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="{Binding Work.ArchiveConfirmationBody}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ConfirmArchiveTaskButton" Classes="primary-action" Content="Archive task"
              Command="{Binding Work.ConfirmArchiveTaskCommand}"
              AutomationProperties.AutomationId="archive-confirm"
              AutomationProperties.Name="Archive task" />
          <Button Classes="view-action" Content="Cancel" Command="{Binding Work.CancelArchiveTaskCommand}"
              AutomationProperties.AutomationId="archive-cancel"
              AutomationProperties.Name="Cancel task archival" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="decision-overlay" IsVisible="{Binding Work.NeedsBulkTaskArchiveConfirmation}">
      <StackPanel Width="470" Spacing="16" AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Work.BulkArchiveConfirmationHeading}" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="{Binding Work.BulkArchiveConfirmationBody}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="ConfirmBulkTaskArchiveButton" Classes="primary-action" Content="Archive Tasks"
              Command="{Binding Work.ConfirmBulkTaskArchiveCommand}"
              AutomationProperties.AutomationId="bulk-archive-confirm"
              AutomationProperties.Name="Confirm bulk Task archive" />
          <Button Classes="view-action" Content="Cancel" Command="{Binding Work.CancelBulkTaskArchiveCommand}"
              AutomationProperties.AutomationId="bulk-archive-cancel"
              AutomationProperties.Name="Cancel bulk Task archive" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="decision-overlay" IsVisible="{Binding Work.NeedsAttachmentChoice}">
      <StackPanel Width="500" Spacing="16" AutomationProperties.LiveSetting="Assertive">
        <StackPanel Spacing="5">
          <TextBlock Text="Choose the Task category" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="The Task and destination Project use different Categories. Choose deliberately; dot-orbit will not recategorise the Task silently." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="PreserveTaskCategory" Classes="primary-action" Content="{Binding Work.PreserveCategoryLabel}" Command="{Binding Work.PreserveTaskCategoryCommand}" AutomationProperties.Name="{Binding Work.PreserveCategoryLabel}" />
          <Button Classes="view-action" Content="{Binding Work.AdoptCategoryLabel}" Command="{Binding Work.AdoptProjectCategoryCommand}" AutomationProperties.Name="{Binding Work.AdoptCategoryLabel}" />
          <Button Classes="view-action" Content="Cancel" Command="{Binding Work.CancelAttachmentCommand}" AutomationProperties.Name="Cancel task move" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>

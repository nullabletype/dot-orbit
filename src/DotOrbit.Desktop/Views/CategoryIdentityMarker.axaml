<UserControl
    x:Class="DotOrbit.Desktop.Views.CategoryIdentityMarker"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DotOrbit.Desktop.Views"
    Focusable="False"
    IsHitTestVisible="False"
    MaxWidth="220"
    AutomationProperties.AccessibilityView="Raw"
    Classes="category-identity-marker">
  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
    <views:IdentityTypeIcon WorkType="Category" ColourKey="{Binding ColourKey, ElementName=Root}" />
    <TextBlock Grid.Column="1" Classes="category-identity-name" VerticalAlignment="Center"
        Text="{Binding CategoryName, ElementName=Root}" TextTrimming="CharacterEllipsis"
        AutomationProperties.AccessibilityView="Raw" />
  </Grid>
</UserControl>

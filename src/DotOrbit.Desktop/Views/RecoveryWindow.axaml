<Window
    x:Class="DotOrbit.Desktop.Views.RecoveryWindow"
    x:DataType="vm:RecoveryViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DotOrbit.Desktop.ViewModels"
    Title="dot-orbit recovery"
    Width="620"
    Height="690"
    MinWidth="560"
    MinHeight="620"
    Background="{DynamicResource BackgroundBrush}"
    WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="36" Spacing="14">
      <TextBlock Classes="eyebrow" Text="ENCRYPTED RECOVERY" />
      <TextBlock FontSize="28" FontWeight="Bold" Text="Recovery points" />
      <TextBlock
          Foreground="{DynamicResource MutedTextBrush}"
          LineHeight="21"
          Text="Create portable encrypted recovery points in any filesystem directory, including one managed by an external sync tool. This is recovery storage, not live synchronisation."
          TextWrapping="Wrap" />

      <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Automatic recovery directory" />
      <TextBlock
          Foreground="{DynamicResource MutedTextBrush}"
          Text="After committed changes, dot-orbit creates at most one automatic encrypted recovery point per hour. It retains 24 hourly, 30 daily, and 12 monthly points; manual and pre-restore points are not pruned automatically."
          TextWrapping="Wrap" />
      <Button
          x:Name="SelectRecoveryDirectoryButton"
          HorizontalAlignment="Left"
          AutomationProperties.HelpText="Choose where hourly automatic encrypted recovery points are written and retained."
          AutomationProperties.Name="Choose automatic recovery directory"
          Click="OnSelectRecoveryDirectory"
          TabIndex="0">
        Choose directory…
      </Button>
      <TextBlock
          x:Name="RecoveryDirectoryText"
          AutomationProperties.Name="Selected recovery directory"
          Foreground="{DynamicResource MutedTextBrush}"
          IsVisible="{Binding HasRecoveryDirectory}"
          Text="{Binding RecoveryDirectoryPath}"
          TextWrapping="Wrap" />
      <Button
          x:Name="CreateRecoveryPointButton"
          HorizontalAlignment="Left"
          AutomationProperties.Name="Create encrypted recovery point"
          Command="{Binding CreateRecoveryPointCommand}"
          TabIndex="1">
        Create recovery point
      </Button>

      <Border Margin="0,10,0,4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" />
      <TextBlock FontWeight="SemiBold" Text="Restore" />
      <TextBlock
          Foreground="{DynamicResource MutedTextBrush}"
          Text="Choose a validated dot-orbit recovery point. Before replacement, dot-orbit creates and validates a recovery point of the current workspace in the selected directory."
          TextWrapping="Wrap" />
      <Button
          x:Name="SelectRecoveryPointButton"
          HorizontalAlignment="Left"
          AutomationProperties.Name="Choose encrypted recovery point"
          Click="OnSelectRecoveryPoint"
          TabIndex="2">
        Choose recovery point…
      </Button>
      <TextBlock
          x:Name="RecoveryPointText"
          AutomationProperties.Name="Selected recovery point"
          Foreground="{DynamicResource MutedTextBrush}"
          IsVisible="{Binding HasRecoveryPoint}"
          Text="{Binding RecoveryPointName}"
          TextWrapping="Wrap" />
      <Button
          x:Name="RequestRestoreButton"
          HorizontalAlignment="Left"
          AutomationProperties.Name="Review restore"
          Command="{Binding RequestRestoreCommand}"
          TabIndex="3">
        Review restore
      </Button>

      <Border
          x:Name="RestoreConfirmationPanel"
          Padding="14"
          Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1"
          CornerRadius="8"
          AutomationProperties.LiveSetting="Assertive"
          AutomationProperties.Name="Restore confirmation"
          IsVisible="{Binding IsRestoreConfirmationVisible}">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" Text="Replace the current workspace?" />
          <TextBlock
              Text="The selected recovery point will replace the current workspace only after both recovery files have been validated."
              TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button
                x:Name="ConfirmRestoreButton"
                AutomationProperties.Name="Confirm restore"
                Command="{Binding ConfirmRestoreCommand}"
                TabIndex="4">
              Restore workspace
            </Button>
            <Button
                x:Name="CancelRestoreButton"
                AutomationProperties.Name="Cancel restore"
                Command="{Binding CancelRestoreCommand}"
                TabIndex="5">
              Keep current workspace
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock
          x:Name="RecoveryStatusMessage"
          AutomationProperties.LiveSetting="Assertive"
          Foreground="{DynamicResource MutedTextBrush}"
          IsVisible="{Binding HasStatusMessage}"
          Text="{Binding StatusMessage}"
          TextWrapping="Wrap" />
      <Button
          x:Name="CloseRecoveryButton"
          HorizontalAlignment="Right"
          AutomationProperties.Name="Close recovery"
          Click="OnClose"
          IsCancel="True"
          TabIndex="6">
        Close
      </Button>
    </StackPanel>
  </ScrollViewer>
</Window>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Bebop.JsonSchema" Version="1.1.0" />
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <!-- Keep the Microsoft Testing Platform and its extensions on one current release line. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.1" />
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <!-- Avalonia.Headless.XUnit 12.1.3 requires the xUnit 3.2 discovery API; select its supported MTP v2 package explicitly. -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
